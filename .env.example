# Supabase connection.
#
# Copy to .env.local and fill in. For local development the values come from
# `supabase status -o env` after `supabase start`.
#
# NEXT_PUBLIC_ variables are inlined into the browser bundle. Only the URL and
# the anon/publishable key may ever carry that prefix.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. NEVER prefix this with NEXT_PUBLIC_ and never import it into a
# client component. It bypasses row level security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Local-only, used by the RLS isolation tests to connect as seeded users.
SUPABASE_TEST_PASSWORD=mastline-dev-password

# Inbound delivery webhooks. A per-provider secret takes precedence; the
# default is a fallback for local development. With neither set, the webhook
# endpoint refuses every request rather than accepting unverified writes.
WEBHOOK_SECRET_DEFAULT=
# WEBHOOK_SECRET_BACKGRID=

# Billing (Stripe). Without these the billing endpoints refuse every request
# rather than accepting unverified writes, and the interface says billing is
# unavailable instead of offering a checkout that cannot work.
#
# NOTE: choosing Stripe over a merchant of record means Mastline is the seller
# of record and owns VAT / sales tax registration in every jurisdiction it
# sells into. That is a business obligation, not a configuration value.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# One price per plan and billing period, created in the Stripe dashboard.
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=
STRIPE_PRICE_STUDIO_MONTHLY=

# The canonical public origin, used for sitemap URLs, robots.txt, and Open
# Graph tags. Defaults to https://mastline.co; preview builds fall back to the
# per-deployment VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# Photograph metadata generation (Anthropic). Server only, never NEXT_PUBLIC_.
#
# With no key set, the "Generate metadata" control is not offered at all rather
# than offered and failing, and nothing is queued that could never be drained.
# Everything in the metadata panel can still be entered and confirmed by hand.
#
# Generated metadata is always a draft: it is stored as a suggestion, labelled
# as one, and never usable in a dispatch until a photographer confirms it.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-4-5, which is the cheapest model that can
# read a frame. A model that rejects output_config.effort is handled; changing
# this needs a redeploy, since Vercel only hands a new environment to a new
# deployment. MASTLINE_SUGGESTION_MODEL is still read as a fallback name.
# MASTLINE_METADATA_MODEL=claude-haiku-4-5

# The metadata worker's sweep endpoint, /api/jobs/metadata.
#
# Generation jobs are normally drained by the request that queued them, on the
# tail of the same invocation. The sweep exists for what that misses: a batch
# larger than one drain, and a job whose worker was killed mid-frame. Point a
# scheduler at the endpoint with this value as a bearer token.
#
# With neither this nor CRON_SECRET set, the endpoint refuses every request
# rather than running unbounded model calls for anyone who finds the URL.
# CRON_SECRET is read as a fallback because that is what Vercel Cron sends.
METADATA_WORKER_SECRET=
