# Supabase connection.
#
# Copy to .env.local and fill in. For local development the values come from
# `supabase status -o env` after `supabase start`.
#
# NEXT_PUBLIC_ variables are inlined into the browser bundle. Only the URL and
# the anon/publishable key may ever carry that prefix.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. NEVER prefix this with NEXT_PUBLIC_ and never import it into a
# client component. It bypasses row level security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Local-only, used by the RLS isolation tests to connect as seeded users.
SUPABASE_TEST_PASSWORD=mastline-dev-password

# Inbound delivery webhooks. A per-provider secret takes precedence; the
# default is a fallback for local development. With neither set, the webhook
# endpoint refuses every request rather than accepting unverified writes.
WEBHOOK_SECRET_DEFAULT=
# WEBHOOK_SECRET_BACKGRID=

# Billing (Stripe). Without these the billing endpoints refuse every request
# rather than accepting unverified writes, and the interface says billing is
# unavailable instead of offering a checkout that cannot work.
#
# NOTE: choosing Stripe over a merchant of record means Mastline is the seller
# of record and owns VAT / sales tax registration in every jurisdiction it
# sells into. That is a business obligation, not a configuration value.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# One price per plan and billing period, created in the Stripe dashboard.
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=
STRIPE_PRICE_STUDIO_MONTHLY=

# The canonical public origin, used for sitemap URLs, robots.txt, and Open
# Graph tags. Defaults to https://mastline.co; preview builds fall back to the
# per-deployment VERCEL_URL.
NEXT_PUBLIC_SITE_URL=
